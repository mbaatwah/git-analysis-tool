{
  "name": "git-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "Git analysis tool for visualizing technical debt",
  "scripts": {
    "backend": "npm run dev --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "install:all": "npm install"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
